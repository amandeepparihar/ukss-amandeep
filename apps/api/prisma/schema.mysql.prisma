  optionsValuesId                         Int       @map("options_values_id") @default(0)
  optionsValuesPrice                      Decimal   @map("options_values_price") @db.Decimal(15, 4) @default(0.0000)
  optionsValuesSku                        String    @map("options_values_sku") @db.VarChar(30)
  pricePrefix                             String    @map("price_prefix") @db.Char(1)
  productsOptionsSortOrder                Int       @map("products_options_sort_order") @default(0)
  productAttributeIsFree                  Boolean   @map("product_attribute_is_free") @default(false)
  productsAttributesWeight                Float     @map("products_attributes_weight") @default(0)
  productsAttributesWeightPrefix          String    @map("products_attributes_weight_prefix") @db.Char(1)
  attributesDisplayOnly                   Boolean   @map("attributes_display_only") @default(false)
  attributesDefault                       Boolean   @map("attributes_default") @default(false)
  attributesDiscounted                    Boolean   @map("attributes_discounted") @default(true)
  attributesImage                         String?   @map("attributes_image") @db.VarChar(64)
  attributesPriceBaseIncluded             Boolean   @map("attributes_price_base_included") @default(true)
  attributesPriceOnetime                  Decimal   @map("attributes_price_onetime") @db.Decimal(15, 4) @default(0.0000)
  attributesPriceFactor                   Decimal   @map("attributes_price_factor") @db.Decimal(15, 4) @default(0.0000)
  attributesPriceFactorOffset             Decimal   @map("attributes_price_factor_offset") @db.Decimal(15, 4) @default(0.0000)
  attributesPriceFactorOnetime            Decimal   @map("attributes_price_factor_onetime") @db.Decimal(15, 4) @default(0.0000)
  attributesPriceFactorOnetimeOffset      Decimal   @map("attributes_price_factor_onetime_offset") @db.Decimal(15, 4) @default(0.0000)
  attributesQtyPrices                     String?   @map("attributes_qty_prices") @db.Text
  attributesQtyPricesOnetime              String?   @map("attributes_qty_prices_onetime") @db.Text
  attributesPriceWords                    Decimal   @map("attributes_price_words") @db.Decimal(15, 4) @default(0.0000)
  attributesPriceWordsFree                Int       @map("attributes_price_words_free") @default(0)
  attributesPriceLetters                  Decimal   @map("attributes_price_letters") @db.Decimal(15, 4) @default(0.0000)
  attributesPriceLettersFree              Int       @map("attributes_price_letters_free") @default(0)
  attributesRequired                      Boolean   @map("attributes_required") @default(false)
  lsReferenceProduct                      String    @map("lsReferenceProduct") @db.VarChar(20)
  qunatity                                String    @map("qunatity") @db.VarChar(20) // Note: typo in original table name
  dateAdded                               DateTime  @map("date_added") @default(now()) @updatedAt
  productAttributeSalePriceAll            Decimal   @map("product_attribute_sale_price_all") @db.Decimal(15, 4)
  productAttributeSalePriceCat            Decimal   @map("product_attribute_sale_price_cat") @db.Decimal(15, 4)
  productAttributeSalePriceProd           Decimal   @map("product_attribute_sale_price_prod") @db.Decimal(15, 4)
  attributeSaleStartDate                  DateTime  @map("attribute_sale_start_date") @db.Date
  attributeSaleEndDate                    DateTime  @map("attribute_sale_end_date") @db.Date
  attributeSaleType                       String    @map("attribute_sale_type") @db.VarChar(1) // enum('0','1','2')
  quantity                                Int       @map("quantity")
  subbuteoTshirtsColour                   Int       @map("subbuteo_tshirts_colour") @default(0)
  subbuteoPlayerColour                    Int       @map("subbuteo_player_colour") @default(0)
  subbuteoTextColour                      Int       @map("subbuteo_text_colour") @default(0)
  heartColour                             Int       @map("heart_colour") @default(0)
  shortname                               String?   @map("shortname") @db.VarChar(10)
  dateModified                            DateTime  @map("date_modified")
  rakutenProduct                          String    @map("rakuten_product") @db.VarChar(3) // enum('No','Yes')
  lazadaProduct                           Boolean   @map("lazada_product") @default(false)
  paStatus                                Boolean   @map("pa_status") @default(true)

  @@index([productsId, optionsId, optionsValuesId], map: "idx_id_options_id_values_zen")
  @@index([productsOptionsSortOrder], map: "idx_opt_sort_order_zen")
  @@index([optionsValuesPrice])
  @@index([optionsValuesId])
  @@index([shortname])
  @@index([dateModified])
  @@index([rakutenProduct])
  @@map("products_attributes")
}

// Products Options table (UKSS product option types like Size, Color, etc.)
model ProductsOption {
  productsOptionsId              Int       @map("products_options_id")
  languageId                     Int       @map("language_id") @default(1)
  productsOptionsName            String    @map("products_options_name") @db.VarChar(32)
  productsOptionsSortOrder       Int       @map("products_options_sort_order") @default(0)
  productsOptionsType            Int       @map("products_options_type") @default(0)
  productsOptionsLength          Int       @map("products_options_length") @db.SmallInt @default(32)
  productsOptionsComment         String?   @map("products_options_comment") @db.VarChar(64)
  productsOptionsSize            Int       @map("products_options_size") @db.SmallInt @default(32)
  productsOptionsImagesPerRow    Int?      @map("products_options_images_per_row") @default(5)
  productsOptionsImagesStyle     Int?      @map("products_options_images_style") @default(0)
  productsOptionsRows            Int       @map("products_options_rows") @db.SmallInt @default(1)
  categoryId                     Int?      @map("category_id") @default(0)
  productsOptionsStatus          Int       @map("products_options_status") @db.TinyInt

  @@id([productsOptionsId, languageId])
  @@index([languageId], map: "idx_lang_zen")
  @@index([languageId, productsOptionsId], map: "RS_DanB_18")
  @@index([productsOptionsSortOrder], map: "idx_products_options_sort_order_zen")
  @@index([productsOptionsName], map: "idx_products_options_name_zen")
  @@index([productsOptionsId])
  @@index([productsOptionsName], map: "products_options_name")
  @@map("products_options")
}

// Products Options Values table (UKSS product option values like S, M, L, XL, etc.)
model ProductsOptionsValue {
  productsOptionsValuesId          Int       @id @map("products_options_values_id")
  languageId                       Int       @map("language_id") @default(1)
  productsOptionsValuesName        String    @map("products_options_values_name") @db.VarChar(64)
  productsOptionsValuesSortOrder   Int       @map("products_options_values_sort_order") @default(0)
