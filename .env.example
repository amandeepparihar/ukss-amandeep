# ============================================
# Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# For Docker: docker-compose uses these variables
# For local dev: API and Web apps use these variables
# ============================================

# App
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3002
API_URL=http://localhost:4000
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL_PREFIX=/uploads

# New Product wizard image save directory.
# Default ./images is fine for dev. In staging/production, override to the
# host bind-mounted path that maps to the legacy SMS web root (e.g.
# /home/ukssmain/public_html/images) so saved files are reachable at
# https://www.uksoccershop.com/images/... directly.
PRODUCT_IMAGES_PATH=./images

# ============================================
# Docker Compose Variables
# ============================================
# These are used by docker-compose.yml

# PostgreSQL (Docker)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=admin_panel

# Redis Password (Docker) - Generate with: openssl rand -hex 24
REDIS_PASSWORD=redis_secure_password_change_me

# MinIO/S3 (Docker)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MariaDB (Docker) - alternative to PostgreSQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=admin_panel
MYSQL_USER=admin
MYSQL_PASSWORD=admin123

# Frontend API URL (Docker build arg)
VITE_API_URL=http://localhost:4000/api

# Default FC (fulfilment-centre) box code (mirrors orders FC_BOX_NUMBER / localconfigure.php:299)
VITE_FC_BOX_NUMBER=FC2023

# ============================================
# Application Variables
# ============================================
# These are used by the API server

# Database Provider: 'postgresql' or 'mysql'
# Determines which Prisma client to use at runtime
DATABASE_PROVIDER=postgresql

# PostgreSQL Database (default)
DATABASE_URL=postgresql://admin:admin123@localhost:15432/admin_panel

# MySQL/MariaDB Database (alternative)
# Used when DATABASE_PROVIDER=mysql
MYSQL_DATABASE_URL=mysql://admin:admin123@localhost:13306/admin_panel

# Redis (Docker container mapped to host port 16379)
REDIS_URL=redis://localhost:16379
# Redis internal URL (used by Docker containers to reach Redis via internal network)
REDIS_URL_INTERNAL=redis://redis:6379

# JWT - IMPORTANT: Generate a secure secret with: openssl rand -hex 32
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth (optional - enables "Login with Gmail" button)
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads
S3_REGION=us-east-1

# ============================================
# Email Configuration
# ============================================
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# SendGrid (alternative)
SENDGRID_API_KEY=

# ============================================
# SMS Configuration (optional)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug

# ============================================
# Fruugo Marketplace Configuration
# ============================================
# Authentication
FRUUGO_API_ID=your-email@example.com
FRUUGO_API_PASSWORD=your-api-password

# API Endpoints
FRUUGO_INVENTORY_URL=https://www.fruugo.com/merchants/stockupdate
FRUUGO_LISTINGS_URL=https://www.fruugo.com/merchants/listings?page=

# Store Configuration
FRUUGO_STORE_ID=123
FRUUGO_PTS_STATUS=1

# Feed Settings
FRUUGO_FEED_DIR=/path/to/feeds/fruugo
FRUUGO_CDN_URL=https://cdn.example.com

# Optional: Filter Settings (comma-separated)
# FRUUGO_EXCLUDED_MANUFACTURER_IDS=1,2,3
# FRUUGO_EXCLUDED_PRODUCT_TYPE_IDS=5,6
# FRUUGO_KIDS_SIZE_GUIDES=kids-small,kids-medium

# Optional: Batch Settings
# FRUUGO_INVENTORY_BATCH_SIZE=100
# FRUUGO_SKU_SYNC_BATCH_SIZE=5000
# FRUUGO_PARALLEL_PAGES=4
# FRUUGO_API_TIMEOUT_MS=30000
# ============================================
# SportDeal Marketplace Configuration
# ============================================
# Store Configuration
SPORTDEAL_STORE_ID=127

# Feed Settings (required)
SPORTDEAL_FEED_DIR=/path/to/feeds/sportdeal_feed

# Marketplace Sync Configuration for SportDeal
# Note: Set to high values for unlimited sync (send all products)
MARKETPLACE_SPORTDEAL_MAX_PRODUCTS=999999
MARKETPLACE_SPORTDEAL_BATCH_SIZE=999999
MARKETPLACE_SPORTDEAL_BATCH_DELAY=0
MARKETPLACE_SPORTDEAL_MAX_RETRIES=3
MARKETPLACE_SPORTDEAL_MAX_QUANTITY_CAP=0

# Optional: Only sync bestsellers
# MARKETPLACE_SPORTDEAL_BESTSELLERS_ONLY=false

# ============================================
# Allegro Marketplace Configuration
# ============================================
# OAuth2 Authentication (client credentials — tokens stored in store_management DB table)
ALLEGRO_CLIENT_ID=add-your-client-id-here
ALLEGRO_CLIENT_SECRET=add-your-client-secret-here

# API Endpoints
ALLEGRO_API_BASE_URL=https://api.allegro.pl
ALLEGRO_AUTH_URL=https://allegro.pl/auth/oauth/token

# Store Configuration
ALLEGRO_STORE_ID=151

# Pricing: margin % added on top of GBP→PLN converted price (0 = no margin)
ALLEGRO_MARGIN_PERCENT=0

# Marketplace Sync Configuration for Allegro
MARKETPLACE_ALLEGRO_MAX_PRODUCTS=999999
MARKETPLACE_ALLEGRO_BATCH_SIZE=50
MARKETPLACE_ALLEGRO_BATCH_DELAY=3
MARKETPLACE_ALLEGRO_MAX_RETRIES=3
MARKETPLACE_ALLEGRO_MAX_QUANTITY_CAP=0


# ============================================
# eBay sync error-code classification (optional overrides; sensible defaults baked in)
# ============================================
# Comma-separated eBay Trading API error codes. Defaults match production-observed codes
# for store 94; override only if eBay changes/extends them.
# Redundant-revision (eBay already holds the sent value) -> counted as success:
# EBAY_REDUNDANT_REVISION_ERROR_CODES=21917091,21917092,21917093
# Account-level monthly listing-limit ("£3,000,000 you can list this month") -> freeze run:
# EBAY_LISTING_LIMIT_ERROR_CODES=21919188,21919189
# Listing not Managed-by-SKU -> retry ItemID-only, then suspend:
# EBAY_SKU_NOT_MANAGED_ERROR_CODES=21916799
# (Terminal codes — ended/not-found 21916750/21916734/21916587/231, policy/duplicate
#  21920397/21919067 — are mapped in code, not env.)

# Max Browse API suspect-verification calls per eBay reconciliation run
EBAY_RECON_BROWSE_CAP=200


# ============================================
# Dify image workflows (New Product page)
# ============================================
# Used by /products/new enhance and remove-background actions when
# USE_DIFY_FOR_IMAGES=true. See documentation/specs/2026-05-08-dify-image-workflows-design.md.
DIFY_ENHANCE_API_KEY=
DIFY_REMOVE_BG_API_KEY=
# Set to "true" to route enhance / remove-bg through Dify instead of Replicate / remove.bg.
# Leave false to keep the legacy direct-call paths.
USE_DIFY_FOR_IMAGES=false


# ============================================
# Shopify Products Listing On Shopify
# ============================================
# Used by /src/modules/shopify-products 

# Base Url for images of products
UKSS_HTTP_SERVER=https://zenc.uksoccershop.com

