{
  "name": "admin-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Node.js Admin Panel Framework",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:report": "playwright show-report",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate --filter=@admin/api",
    "db:migrate": "turbo run db:migrate --filter=@admin/api",
    "db:push": "turbo run db:push --filter=@admin/api",
    "db:seed": "turbo run db:seed --filter=@admin/api",
    "db:seed:mysql": "turbo run db:seed:mysql --filter=@admin/api",
    "db:studio": "turbo run db:studio --filter=@admin/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "reconcile-orders": "tsx apps/api/src/cli/reconcile-orders.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^5.8.0",
    "@shopify/admin-api-client": "^1.1.1",
    "@shopify/shopify-api": "^12.2.0",
    "commander": "^14.0.2"
  }
}
