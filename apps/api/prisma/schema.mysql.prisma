// ============================================
// FC Scan / SMS Product & Box Tables
// ============================================

// Legacy ukssmain table shared with SMS. created is clean as of 03-Aug-2026: the 2
// '0000-00-00 00:00:00' rows (seasons_id 128 and 129) were backfilled and the column
// now carries a DB-side DEFAULT current_timestamp().
//
// migration_date_added and migration_date_modified are deliberately NOT declared below.
// They DO exist in the database, are NOT NULL with their own DB-side DEFAULT
// current_timestamp() (migration_date_modified also ON UPDATE current_timestamp()), and
// must stay. Both are clean today (0 zero-dates, unlike `teams`, which holds 4 in each),
// so leaving them out keeps the Prisma row decoder from ever touching them should a
// zero-date appear. Their absence here is NOT license for `prisma db push` / `migrate`
// to drop them — pushing this schema at MySQL would generate a destructive DROP COLUMN
// for both.
model Season {
  seasonsId Int    @id @default(autoincrement()) @map("seasons_id")
  // UNIQUE at the DB level (index `season_2`), not a plain index like teams.team_name.
  // Note seasons_id 128 already occupies the '' slot, so blank is not insertable twice.
  season    String @unique(map: "season_2") @db.VarChar(11)
  // Both NOT NULL with no DB default: every write must supply a value
  // (legacy passes '' when unused — 197/212 rows have an empty tesco_seasons).
  tescoSeasons          String   @map("tesco_seasons") @db.VarChar(11)
  rueducommerceSeason   String   @map("rueducommerce_season") @db.VarChar(11)
  sort                  Int
  // dbgenerated, not now(): now() makes Prisma fill this client-side in UTC, which
  // drifts from the DB's own current_timestamp() default that legacy relies on.
  created               DateTime @default(dbgenerated("current_timestamp()")) @db.DateTime(0)

  productLists    ProductList[]
  smsProductsLogs SmsProductsLog[]

  @@index([sort], map: "sort")
  @@map("seasons")
}

// Legacy ukssmain table shared with SMS. created is clean as of 03-Aug-2026: the 30
// '0000-00-00 00:00:00' rows were backfilled and the column now carries a DB-side
// DEFAULT current_timestamp(), so it is safe to read through Prisma directly.
// migration_date_added and migration_date_modified still hold 4 zero-date rows each,
// and the Prisma row decoder throws on those, so a bare findMany()/findUnique() that
// decodes every scalar will still fail. Reads must `select` the columns they need.
//
// Those two columns are therefore deliberately NOT declared below. They DO exist in
// the database, carry their own DB-side DEFAULT current_timestamp(), and must stay.
// Their absence here is intentional (it keeps the decoder from ever touching the
// zero-date rows) and is NOT license for `prisma db push` / `migrate` to drop them —
// pushing this schema at MySQL would generate a destructive DROP COLUMN for both.
model Team {
  teamsId               Int                @id @default(autoincrement()) @map("teams_id")
  teamName              String             @map("team_name") @db.VarChar(55)
  sort                  Int
  created               DateTime           @default(dbgenerated("current_timestamp()")) @db.DateTime(0)
  // The DB column has no explicit DEFAULT; MariaDB falls back to the first ENUM
  // member ('Clothing') when the column is omitted, which is what the legacy
  // INSERT relied on. Declared here so Prisma reproduces that same value.
  teamType              TeamType           @default(Clothing) @map("team_type")
  invalidTeamForAmazon  TeamAmazonValidity @default(Valid) @map("invalid_team_for_amazon")

  productLists    ProductList[]
  smsProductsLogs SmsProductsLog[]

  @@index([teamName], map: "team_name")
  @@index([sort], map: "sort")
  @@index([teamType], map: "team_type")
  @@map("teams")
}

// Legacy ukssmain table shared with SMS. Only the primary key and the two foreign keys
// used by the delete guards in teams.service.ts / seasons.service.ts are declared; the
// remaining columns (sms_users_id, product_lists_id, the previous_*/current_* pairs,
// modified, ip_address, migration_date_added, migration_date_modified) DO exist in the
// database and must stay — their absence here is NOT license for `prisma db push` /
// `migrate` to drop them, which is what pushing this schema at MySQL would generate.
model SmsProductsLog {
  smsProductsLogsId Int @id @default(autoincrement()) @map("sms_products_logs_id")
  teamsId           Int @map("teams_id")
  seasonsId         Int @map("seasons_id")

  team   Team   @relation(fields: [teamsId], references: [teamsId])
  season Season @relation(fields: [seasonsId], references: [seasonsId])

  @@index([teamsId], map: "fk_Team")
  @@index([seasonsId], map: "fk_Season")
  @@map("sms_products_logs")
}

enum TeamType {
  Clothing
  KidsBoots     @map("Kids Boots")
  AdultsBoots   @map("Adults Boots")
  PumaKidsBoots @map("Puma Kids Boots")
}

enum TeamAmazonValidity {
  Valid
  Invalid
}

