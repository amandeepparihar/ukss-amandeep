  shortname                        String    @map("shortname") @db.VarChar(50)
  sizenameInCopasheet              String    @map("sizename_in_copasheet") @db.VarChar(50)
  image                            String?   @map("image") @db.VarChar(200)
  defaultPrice                     Decimal   @map("defualt_price") @db.Decimal(15, 4) @default(0.0000) // Note: typo in original column name
  mappedSpeySoftwareSizes          String?   @map("mapped_spey_software_sizes") @db.VarChar(1) // enum('0','1')

  sizeOptionMappings               ProductsOptionsValuesToProductsOption[]

  @@index([productsOptionsValuesName], map: "idx_products_options_values_name_zen")
  @@index([productsOptionsValuesSortOrder], map: "idx_products_options_values_sort_order_zen")
  @@index([productsOptionsValuesId])
  @@index([nonVat])
  @@map("products_options_values")
}

