// MySQL/MariaDB Prisma schema
// Compatible with MySQL 8.0+ and MariaDB 10.3+
// Usage: prisma generate --schema=./prisma/schema.mysql.prisma

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client-mysql"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

// ============================================
// User & Authentication Models
// ============================================

model User {
  id                   String  @id @default(cuid())
  email                String  @unique
  password             String
  firstName            String
  lastName             String
  avatar               String?
  isActive             Boolean @default(true)
  emailVerified        Boolean @default(false)
  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String? @db.Text // JSON array of hashed backup codes

  // Failed login tracking
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Role relation
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Relations
  sessions                Session[]
  auditLogs               AuditLog[]
  uploadedFiles           File[]
  notifications           Notification[]
  notificationPreferences UserNotificationPreference[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([email])
  @@index([roleId])
  @@index([isActive])
  @@index([createdAt])
  @@map("jsa_users")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text
  isSystem    Boolean @default(false) // Can't delete system roles

  permissions Permission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isSystem])
  @@map("jsa_roles")
}

model Permission {
  id       String @id @default(cuid())
  resource String // e.g., "users", "orders", "reports"
  action   String // e.g., "view", "create", "edit", "delete"

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([resource])
  @@index([action])
  @@map("jsa_permissions")
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String  @unique @db.VarChar(500)
  userAgent    String? @db.Text
  ipAddress    String?
  deviceInfo   Json?

  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("jsa_sessions")
}

// ============================================
// Cross-Application Shared Admin Session
// Ticket ID: 164781 - Single Sign-On between Node.js and PHP applications
// ============================================

model SharedAdminSession {
  id           String   @id @default(cuid())
  token        String   @unique @db.VarChar(128)

  // User identification (email is common between both apps)
  userEmail    String   @db.VarChar(255)

  // Node.js user reference (optional - may not exist if login from PHP)
  nodeUserId   String?

  // PHP user reference (sms_users_id from PHP application)
  phpUserId    Int?

  // Session metadata (reusing pattern from Session model)
  ipAddress    String?
  userAgent    String?  @db.Text

  // Timestamps (following existing patterns)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([token])
  @@index([userEmail])
  @@index([nodeUserId])
  @@index([phpUserId])
  @@index([expiresAt])
  @@map("jsa_shared_admin_sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@map("jsa_password_resets")
}

model TrustedDevice {
  id          String  @id @default(cuid())
  userId      String
  fingerprint String
  name        String?
  browser     String?
  os          String?
  deviceType  String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("jsa_trusted_devices")
}

model LoginHistory {
  id            String  @id @default(cuid())
  userId        String
  ipAddress     String
  userAgent     String? @db.Text
  fingerprint   String?
  location      String?
  browser       String?
  os            String?
  deviceType    String?
  isTrusted     Boolean @default(false)
  success       Boolean @default(true)
  failureReason String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([success])
  @@index([createdAt])
  @@map("jsa_login_histories")
}

model EmailVerification {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@map("jsa_email_verifications")
}

// ============================================
// Audit & Logging Models
// ============================================

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String // e.g., "login", "logout", "create", "update", "delete"
  resource   String // e.g., "user", "order"
  resourceId String?

  oldValues Json?
  newValues Json?
  metadata  Json? // IP, user agent, etc.

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@map("jsa_audit_logs")
}

model SystemLog {
  id String @id @default(cuid())

  level   String // info, warn, error, etc.
  module  String // Module name
  message String @db.Text

  // Context
  requestId String?
  userId    String?
  sessionId String?

  // Data
  data  Json?
  error Json? // Stack trace, error details

  // Request context
  method     String?
  path       String?
  statusCode Int?
  duration   Int? // ms
  ip         String?
  userAgent  String? @db.Text

  createdAt DateTime @default(now())

  @@index([level])
  @@index([module])
  @@index([userId])
  @@index([createdAt])
  @@map("jsa_system_logs")
}

// ============================================
// Menu System Models
// ============================================

model MenuItem {
  id         String  @id @default(cuid())
  label      String
  icon       String? // Lucide icon name
  path       String? // Route path or external URL
  isExternal Boolean @default(false)

  parentId String?
  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuHierarchy")

  permission String? // Required permission to see this item
  badgeKey   String? // Key to fetch badge count from API

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([sortOrder])
  @@index([isActive])
  @@map("jsa_menu_items")
}

// ============================================
// File & Media Models
// ============================================

model File {
  id String @id @default(cuid())

  filename String // Original filename
  mimeType String
  size     Int // Size in bytes
  checksum String? // MD5/SHA hash for deduplication

  storageKey String // S3 key
  storageUrl String @db.Text // Full URL

  // For images
  width      Int?
  height     Int?
  thumbnails Json? // { small: url, medium: url, large: url }

  // Processing status
  status      FileStatus @default(PENDING)
  processedAt DateTime?

  // Relations
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([status])
  @@index([mimeType])
  @@index([createdAt])
  @@index([checksum])
  @@map("jsa_files")
}

enum FileStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DELETED
}

// Batch Upload for resumable multi-file uploads
model BatchUpload {
  id     String @id @default(cuid())
  userId String

  // Batch metadata
  totalFiles Int // Expected total number of files
  folder     String @default("uploads")

  // Status tracking
  status      BatchUploadStatus @default(IN_PROGRESS)
  completedAt DateTime?

  // Files in this batch
  items BatchUploadItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // Auto-cleanup after expiry

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("jsa_batch_uploads")
}

model BatchUploadItem {
  id      String      @id @default(cuid())
  batchId String
  batch   BatchUpload @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // File identification (for deduplication)
  clientId String // Client-provided ID for tracking
  checksum String // MD5/SHA hash for deduplication
  filename String // Original filename
  mimetype String
  size     Int

  // Upload status
  status BatchUploadItemStatus @default(PENDING)

  // S3 info (populated after upload)
  storageKey String?
  storageUrl String? @db.Text
  fileId     String? // Reference to File record once complete

  // Error tracking
  error      String? @db.Text
  retryCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, checksum]) // Prevent duplicate files in same batch
  @@unique([batchId, clientId]) // Prevent duplicate client IDs
  @@index([batchId])
  @@index([status])
  @@index([checksum])
  @@map("jsa_batch_upload_items")
}

enum BatchUploadStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
}

enum BatchUploadItemStatus {
  PENDING // Registered but not uploaded
  UPLOADING // Upload in progress
  UPLOADED // Successfully uploaded
  FAILED // Upload failed
  SKIPPED // Skipped (duplicate detected)
}

// ============================================
// Notification Models
// ============================================

model NotificationTemplate {
  id String @id @default(cuid())

  code        String  @unique // e.g., "welcome_email", "order_shipped"
  name        String
  description String? @db.Text

  // Channel-specific content
  channels NotificationTemplateChannel[]

  // Variables this template uses - stored as JSON array for MySQL/MariaDB
  variables Json? // e.g., ["userName", "orderNumber"]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([code])
  @@index([isActive])
  @@map("jsa_notification_templates")
}

model NotificationTemplateChannel {
  id String @id @default(cuid())

  templateId String
  template   NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  subject String? // For email
  content String              @db.Text // Template content with {{variables}}

  @@unique([templateId, channel])
  @@map("jsa_notification_template_channels")
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

model Notification {
  id String @id @default(cuid())

  // Recipient
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Or direct contact (for non-users)
  email       String?
  phone       String?
  deviceToken String?

  // Content
  templateId String?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  channel NotificationChannel
  subject String?
  content String              @db.Text

  // Status
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  error       String?            @db.Text

  // Retry
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRetryAt DateTime?

  // Scheduling
  scheduledFor DateTime?

  // Priority
  priority Int @default(5) // 1 = highest

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([priority])
  @@index([scheduledFor])
  @@index([createdAt])
  @@map("jsa_notifications")
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

model UserNotificationPreference {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  enabled Boolean             @default(true)

  // Quiet hours
  quietHoursStart String? // "22:00"
  quietHoursEnd   String? // "08:00"
  timezone        String?

  @@unique([userId, channel])
  @@map("jsa_user_notification_preferences")
}

// ============================================
// Settings & Configuration Models
// ============================================

model SystemSetting {
  id String @id @default(cuid())

  key   String      @unique
  value Json
  type  SettingType

  category    String // e.g., 'general', 'email', 'security'
  label       String
  description String? @db.Text

  isPublic Boolean @default(false) // Can be fetched without auth

  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
  @@map("jsa_system_settings")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SECRET
}

model FeatureFlag {
  id String @id @default(cuid())

  key         String  @unique
  name        String
  description String? @db.Text

  enabled Boolean @default(false)

  // Optional: enable for specific users/roles
  rules Json? // { users: [], roles: [], percentage: 10 }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([enabled])
  @@map("jsa_feature_flags")
}

// Translation overrides (database-stored translations)
model Translation {
  id String @id @default(cuid())

  locale String // e.g., 'en', 'es', 'fr'
  key    String // e.g., 'auth.login.success'
  value  String @db.Text // The translated text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, key])
  @@index([locale])
  @@map("jsa_translations")
}

// ============================================
// Export Models
// ============================================

model Export {
  id String @id @default(cuid())

  resource String
  format   ExportFormat
  filters  Json?
  columns  Json? // Stored as JSON array for MySQL/MariaDB

  template String? // For PDF

  // Status
  status ExportStatus @default(PENDING)

  // Result
  fileUrl  String? @db.Text
  fileSize Int?
  rowCount Int?

  error String? @db.Text

  // User who requested
  userId String

  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("jsa_exports")
}

enum ExportFormat {
  CSV
  EXCEL
  PDF
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// Announcement Models
// ============================================

model Announcement {
  id String @id @default(cuid())

  title   String
  content String           @db.Text // Markdown content
  type    AnnouncementType @default(INFO)

  // Visibility
  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  // Targeting - stored as JSON array for MySQL/MariaDB
  targetRoles Json? // Empty = all users
  dismissable Boolean @default(true)

  // Display options - stored as JSON array for MySQL/MariaDB
  showOnPages Json? // Empty = all pages
  priority    Int   @default(5) // 1 = highest

  // Tracking
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
  @@index([priority])
  @@map("jsa_announcements")
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

model AnnouncementDismissal {
  id             String @id @default(cuid())
  userId         String
  announcementId String

  dismissedAt DateTime @default(now())

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
  @@map("jsa_announcement_dismissals")
}

// ============================================
// Scheduled Jobs Models
// ============================================

model ScheduledJob {
  id String @id @default(cuid())

  name        String  @unique
  description String? @db.Text

  // Scheduling
  cron     String // Cron expression
  timezone String @default("UTC")

  // Handler
  handler String // Handler function name
  payload Json? // Default payload for the job

  // Status
  isEnabled Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  // Execution tracking
  runs ScheduledJobRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
  @@index([nextRunAt])
  @@map("jsa_scheduled_jobs")
}

model ScheduledJobRun {
  id String @id @default(cuid())

  jobId String
  job   ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Execution details
  status      ScheduledJobStatus @default(RUNNING)
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  duration    Int? // Duration in milliseconds

  // Results
  result Json?
  error  String? @db.Text
  logs   String? @db.LongText // Execution logs

  // Trigger info
  triggeredBy String? // 'cron' | 'manual' | userId

  @@index([jobId])
  @@index([status])
  @@index([startedAt])
  @@map("jsa_scheduled_job_runs")
}

enum ScheduledJobStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Tracks sync job execution history
model MarketplaceSyncHistory {
  id String @id @default(cuid())

  // Job identification
  storeId         Int // Marketplace store ID
  marketplaceName String // Human-readable name
  operation       String // e.g., "inventory_sync", "product_feed", "sku_mapping"
  correlationId   String? // For log correlation

  // Execution timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int? // Execution duration in milliseconds

  // Results
  status MarketplaceSyncJobStatus @default(RUNNING)

  // Counts
  totalItems     Int @default(0) // Total items attempted
  newItemsListed Int @default(0) // New items added to marketplace (delta listing)
  itemsUpdated   Int @default(0) // Existing items updated
  itemsFailed    Int @default(0) // Items that failed

  // Error details
  errorSummary String? @db.VarChar(500) // Brief error summary
  errorDetails Json? // Detailed error info (first N errors)

  // Trigger info
  triggeredBy String? // 'cron' | 'manual' | userId

  // Additional context
  metadata Json? // Job-specific metadata

  createdAt DateTime @default(now())

  @@index([storeId, operation])
  @@index([storeId, startedAt])
  @@index([status])
  @@index([correlationId])
  @@map("jsa_MarketplaceSyncHistory")
}

enum MarketplaceSyncJobStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

// ============================================
// Demo Models - Reusable DataTable Pattern
// ============================================

// Master table for product categories
model DemoCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  products DemoProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("jsa_demo_categories")
}

// Master table for product statuses
model DemoStatus {
  id        String  @id @default(cuid())
  name      String  @unique
  label     String // Display label
  color     String? // For UI badge color
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  products DemoProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("jsa_demo_statuses")
}

// Main data table - can have millions of rows
model DemoProduct {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  description    String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)
  isDeleted      Boolean  @default(false) // Soft delete for Shopify unpublish

  // Foreign keys to master tables
  categoryId String
  category   DemoCategory @relation(fields: [categoryId], references: [id])

  statusId String
  status   DemoStatus @relation(fields: [statusId], references: [id])

  // Relations for Shopify sync
  variants   ProductVariant[]
  syncStatus ProductSyncStatus[]
  syncItems  ShopifySyncItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for fast queries on large datasets
  @@index([categoryId])
  @@index([statusId])
  @@index([name])
  @@index([sku])
  @@index([price])
  @@index([stock])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([updatedAt])
  @@map("jsa_demo_products")
}

// Product variants (sizes, colors, etc.)
model ProductVariant {
  id        String      @id @default(cuid())
  productId String
  product   DemoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String   @unique
  title          String // e.g., "Small / Red"
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)

  option1 String? // Size
  option2 String? // Color
  option3 String? // Material

  shopifyVariantId String? // Shopify variant GID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([updatedAt])
  @@map("jsa_product_variants")
}

// ============================================
// Shopify Sync Module
// ============================================

// Shopify store credentials
model ShopifyStore {
  id           String    @id @default(cuid())
  name         String // Display name (e.g., "US Store")
  shopDomain   String    @unique // mystore.myshopify.com
  accessToken  String    @db.Text // Encrypted OAuth token
  apiVersion   String    @default("2024-01") // Shopify API version
  isActive     Boolean   @default(true)
  syncInterval Int       @default(60) // Minutes between syncs
  lastSyncAt   DateTime?

  syncs         ShopifySync[]
  productStatus ProductSyncStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("jsa_shopify_stores")
}

// Sync job history (retained 30 days)
model ShopifySync {
  id      String       @id @default(cuid())
  storeId String
  store   ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  status      SyncStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?

  totalProducts Int @default(0)
  processed     Int @default(0)
  created       Int @default(0)
  updated       Int @default(0)
  failed        Int @default(0)

  checkpoint   String? @db.Text // JSON: { lastProductId, batchNumber }
  errorMessage String? @db.Text

  items ShopifySyncItem[]

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@map("jsa_shopify_syncs")
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

// Per-product sync status (for failures/retries)
model ShopifySyncItem {
  id     String      @id @default(cuid())
  syncId String
  sync   ShopifySync @relation(fields: [syncId], references: [id], onDelete: Cascade)

  productId String
  product   DemoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  status       ItemSyncStatus @default(PENDING)
  shopifyId    String? // Shopify product GID
  errorMessage String?        @db.Text
  retryCount   Int            @default(0)

  @@index([syncId])
  @@index([productId])
  @@index([status])
  @@map("jsa_shopify_sync_items")
}

enum ItemSyncStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

// Per-store sync tracking (dirty flag per store)
model ProductSyncStatus {
  id        String       @id @default(cuid())
  productId String
  product   DemoProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  needsSync  Boolean   @default(true)
  shopifyId  String? // Shopify product GID for this store
