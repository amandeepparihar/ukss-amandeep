model ProductQuantity {
  productQuantitiesId Int    @id @default(autoincrement()) @map("product_quantities_id")
  productListsId      Int    @map("product_lists_id")
  sizeId              Int    @map("size_id")
  smsSizeGroupsId     Int?   @map("sms_size_groups_id")
  boxListsId          Int    @map("box_lists_id")
  barcode             String @db.VarChar(13)
  quantity            Int
  sizeWeight          Decimal @map("size_weight") @db.Decimal(7, 3)
  fcProductId         Int?   @map("fc_product_id")
  // The Green FC update cron's queue flag: it picks a barcode up while this is
  // NULL or not 1, and sets it to 1 once pushed. Int and not Boolean because the
  // legacy semantics are three-valued (NULL / 0 / 1) and the SMS side compares
  // it with `!= 1`, which Boolean would obscure.
  fcUpdateProductBit  Int?   @map("fc_update_product_bit") @db.TinyInt

  productList  ProductList                          @relation(fields: [productListsId], references: [productListsId])
  boxList      BoxList                              @relation(fields: [boxListsId], references: [boxListsId])
  sizeMapping ProductsOptionsValuesToProductsOption @relation(fields: [sizeId], references: [productsOptionsValuesToProductsOptionsId])

  @@unique([productListsId, sizeId, boxListsId])
  @@unique([fcProductId])
  @@index([productListsId])
  @@index([boxListsId])
  @@index([sizeId])
  @@index([smsSizeGroupsId])
  @@index([barcode])
  @@index([barcode, boxListsId])
  @@map("product_quantities")
}

// Currency table (for conversion rates)
//
// Corrected against the live `ukssmain.currencies` DESCRIBE for Redmine #166532.
// The previous mapping declared `value` as Decimal(15,4) while the column is
// Decimal(13,8), and omitted last_updated and decimal_places entirely — the three
// fields the Medusa price sync depends on. Rates are read as Decimal and converted
// with .toString() so the full 8 decimal places survive; a Number() anywhere in
// that path reintroduces float drift into ten million generated prices.
//
// Read-only mapping. Nothing in this application writes to `currencies`; the
// legacy Zen Cart cron owns it (see medusa-price-sync/rate-source.ts).
model Currency {
  currencyId  BigInt    @id @default(autoincrement()) @map("currencies_id")
  code        String    @db.Char(3)
  title       String    @db.VarChar(32)
  // "1 GBP = value <code>". GBP itself is held at exactly 1.00000000.
  value       Decimal   @db.Decimal(13, 8)
  // Minor-unit digits, stored as a char. UKSS is the system of record for what
  // UKSS charges, so this — not Medusa's currency precision — is the rounding
  // authority passed to the sync.
  decimalPlaces String? @map("decimal_places") @db.Char(1)
  // Written by whichever legacy cron last ran. This is the snapshot's as-of
  // timestamp and the only staleness signal available.
  lastUpdated DateTime? @map("last_updated")
  symbolRight String?   @map("symbol_right") @db.VarChar(24)
  symbolLeft  String?   @map("symbol_left") @db.VarChar(24)

  @@index([code])
  @@map("currencies")
}

// Country table (for country lookup and shipping info)
model Country {
  countriesId                         Int       @id @default(autoincrement()) @map("countries_id")
  fcCountryId                         Int       @map("fc_country_id")
  countriesName                       String    @map("countries_name") @db.VarChar(100)
  countriesIsoCode2                   String    @map("countries_iso_code_2") @db.Char(2)
  countriesIsoCode3                   String    @map("countries_iso_code_3") @db.Char(3)
  addressFormatId                     Int       @map("address_format_id") @default(0)
  weight                              Decimal   @db.Decimal(15, 4)
  shipmentServicesId                  Int       @map("shipment_services_id")
  currenciesId                        Int       @map("currencies_id")
  shippingStatus                      String    @map("shipping_status") @db.VarChar(1) @default("0")
  countryFlagPath                     String    @map("country_flag_path") @db.VarChar(255)
  message                             String    @db.VarChar(1000)
  europeanCountry                     String    @map("european_country") @db.VarChar(4)
  postcodesRequireCustomsInfo         String    @map("c_postcodes_that_require_customs_info") @db.VarChar(50)
  countriesVatRate                    Decimal?  @map("countries_vat_rate") @db.Decimal(4, 2)

  @@index([countriesName])
  @@index([countriesIsoCode2])
  @@index([countriesIsoCode3])
  @@index([addressFormatId])
  @@index([shipmentServicesId])
  @@map("countries")
}

// Products Attributes table (UKSS product options and variants)
