# ============================================
# Debenhams (Mirakl) Marketplace Configuration
# ============================================
# Carrier-code mapping pushed to Mirakl as tracking.carrier_name (PM #166488).
# JSON object of UKSS carrier slug -> code Mirakl expects. Royal Mail MUST map to
# ROYALMAIL exactly, else Mirakl cannot build the tracking URL shown to Debenhams CS.
# Unmapped carriers pass through unchanged. Required (no default) - the API will not
# boot without it. Add more slugs here to remap other carriers in future.
DEBENHAMS_CARRIER_MAP={"royal_mail":"ROYALMAIL"}

# ============================================
# Medusa Active-Product Price Sync (Redmine #166532)
# ============================================
# Drives the Medusa price-sync Admin API from the UKSS exchange rates so every
# published variant carries a STORED price in each supported currency. GBP stays
# authoritative; nothing converts at runtime in the storefront.
# CLI: node dist/cli/sync-medusa-active-product-prices.js (one-shot, Cronicle/PM2
# with autorestart off).
MEDUSA_API_BASE_URL=
# A Medusa *secret* API key (sk_...), Settings -> Secret API keys. Sent as HTTP
# Basic with the key as username, which is how Medusa's api-key auth works. Give the
# cron its own key so it can be revoked without touching an admin password.
MEDUSA_API_KEY=
# Variants per batch. 250 measured fastest on staging (7.8 ms/variant, ~1.4 h for
# the full 632k-variant catalogue); 25 was slower because bulk insert never amortised.
MEDUSA_PRICE_SYNC_BATCH_SIZE=250
MEDUSA_PRICE_SYNC_TIMEOUT_MS=120000
# Retries apply to timeout/429/5xx only. 401/403/404/422 are never retried.
MEDUSA_PRICE_SYNC_MAX_RETRIES=4
# 192h = 8 days, matching the UKSS weekly rate refresh plus a day of slack. Measured
# 2026-08-05: ukssmain.currencies.last_updated is 2026-03-18, i.e. ~3365h — the
# legacy rate cron has stopped running, and the sync refuses the snapshot until it
# is fixed. That is deliberate: pricing the catalogue off five-month-old rates is
# worse than not pricing it.
MEDUSA_PRICE_SYNC_MAX_RATE_AGE_HOURS=192
# Refuse a snapshot where any single rate moved more than this since the last run —
# a 40% overnight jump is a broken upstream feed far more often than a real event.
MEDUSA_PRICE_SYNC_MAX_RATE_MOVEMENT_PERCENT=10
# Extra commercial margin THIS process must apply, as a percentage. 0 means the
# source already includes it, which is the HLA's assumption: the legacy
# worldpay_exchange_rates cron multiplies by (1 + EXTRA_MARGIN_CURRENCY). Confirm on
# the live UKSS host before changing — that constant is defined nowhere in the PHP
# tree available here, and on PHP 5.6 an undefined constant makes the multiplier 1.
MEDUSA_PRICE_SYNC_MARGIN_PERCENT=0
# Plan and report, write no prices. The run still advances its cursor.
MEDUSA_PRICE_SYNC_DRY_RUN=0
# Stop after N batches (0 = run to completion). Smoke tests only; a capped run is
# reported as INCOMPLETE and exits non-zero.
MEDUSA_PRICE_SYNC_MAX_BATCHES=0
# Optional scope narrowing. Note the sales-channel filter narrows almost nothing:
# product_sales_channel has 237,911 rows for 237,863 products, so `status` does the
# real work.
MEDUSA_PRICE_SYNC_SALES_CHANNEL_ID=
# Where the previous rate snapshot is remembered, for the movement guard. Losing it
# degrades to "guard skipped", which is logged loudly rather than passed over.
MEDUSA_PRICE_SYNC_STATE_FILE=
