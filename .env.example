NP_SEASON=2023-2024

# Cron & Sync Batch Limits
# Max number of products to sync when checking price and inventory updates
FETCH_SHOPIFY_PRICE_AND_INVENTORY_PRODUCT_LIMIT=50
# Max number of products to sync during a standard update cycle
FETCH_SHOPIFY_UPDATE_PRODUCT_LIMIT=50
# Max number of products to sync during an initial product fetch cycle
FETCH_SHOPIFY_PRODUCT_LIMIT=25
# Number of inventory items to batch together in a single update request
SHOPIFY_INVENTORY_BATCH_SIZE=200
# No of days to remove logs 
SHOPIFY_DELETE_OLD_LOGS_FROM_SHOPIFY_TRACKING=30
SHOPIFY_DELETE_OLD_LOGS_FROM_CRON_RUN=30

