model SpProduct {
  sp_id                          Int                      @id @default(autoincrement())
  sm_store_id                    Int
  sm_store_name                  String                   @db.VarChar(200)
  np_products_id                 Int
  sp_ukss_virtual_product_type_id Int                      @db.TinyInt
  sp_product_id                  BigInt?                  @unique
  sp_title                       String                   @db.Text
  sp_body_html                   String                   @db.Text
  sp_vendor                      String                   @db.VarChar(100)
  sp_product_type                String                   @db.VarChar(255)
  sp_handle                      String?                  @db.VarChar(255)
  sp_published_at                DateTime
  sp_status                      SpStatus                 @default(draft)
  sp_create_product_status       SpCreateProductStatus
  sp_ukss_status                 SpUkssStatus
  sp_update_product_status       SpUpdateProductStatus    @default(finalized)
  sp_update_inventory_status     SpUpdateInventoryStatus  @default(finalized)
  sp_update_price_status         SpUpdatePriceStatus      @default(finalized)
  sp_update_image_status         SpUpdateImageStatus      @default(finalized)
  sp_special_status              SpSpecialStatus
  sp_published_scope             SpPublishedScope         @default(global)
  sp_tags                        String                   @db.Text
  sp_option1                     String                   @db.VarChar(50)       @map("sp_option_1")
  sp_option1_id                  BigInt?                                        @map("sp_option_1_id") 
  sp_option1_values              String                   @db.Text
  sp_option_2                    String?                  @db.VarChar(500)
  sp_option_2_id                 BigInt?                  @db.UnsignedBigInt
  sp_option2_values              String?                  @db.Text
  sp_option_3                    String?                  @db.VarChar(50)
  sp_option_3_id                 BigInt?                  @db.UnsignedBigInt
  sp_option3_values              String?                  @db.Text
  sp_google_custom_label0        String?                  @db.VarChar(255)
  sp_google_custom_label1        String?                  @db.VarChar(255)
  sp_google_custom_label2        String?                  @db.VarChar(255)
  sp_google_custom_label3        String?                  @db.VarChar(255)
  sp_google_custom_label4        String?                  @db.VarChar(255)
  created_on_shopify             DateTime?
  updated_on_shopify             DateTime?
  sp_created_at                  DateTime
  sp_updated_at                  DateTime                 @default(dbgenerated("'0000-00-00 00:00:00'"))
  np_products_model              String?                  @db.VarChar(100)
  np_league                      String?                  @db.VarChar(255)
  np_team                        String?                  @db.VarChar(255)
  np_agegroup                    String?                  @db.VarChar(255)
  np_gender                      String?                  @db.VarChar(255)
  np_color                       String?                  @db.VarChar(255)
  np_sleevelength                String?                  @db.VarChar(255)
  sp_update_metafields_status    SpUpdateMetafieldsStatus @default(modified)

  // --- Indexes ---
  @@index([sm_store_id])
  @@index([np_products_id])
  @@index([sp_status])
  @@index([sp_ukss_status])
  @@index([sp_update_product_status])
  @@index([sp_update_inventory_status])
  @@index([sp_update_price_status])
  @@index([sp_update_image_status])
  @@map("shopify_products")
}

enum SpStatus {
  active
  archived
  draft
}

enum SpCreateProductStatus {
  new
  created
  error
  data_missing
  to_be_delete
  deleted
}

enum SpUkssStatus {
  new
  modified
  removed
  finalized
  data_missing
  error
}

enum SpUpdateProductStatus {
  modified
  finalized
  error
}

enum SpUpdateInventoryStatus {
  modified
  finalized
  error
}

enum SpUpdatePriceStatus {
  modified
  finalized
  error
}

enum SpUpdateImageStatus {
  modified
  finalized
  error
}

enum SpSpecialStatus {
  Special
  Not_Special @map("Not Special")
}

enum SpPublishedScope {
  web
  global
}

enum SpUpdateMetafieldsStatus {
  modified
  finalized
  error
}



model ShopifyProductsImage {
  spiId                 Int       @id @default(autoincrement()) @map("spi_id")
  spId                  Int       @map("sp_id")
  smStoreId             Int       @map("sm_store_id")
  smStoreName           String    @db.VarChar(200) @map("sm_store_name")
  npProductId           Int       @map("np_product_id")
  spProductId           BigInt?   @map("sp_product_id")
  spiImageId            BigInt?   @map("spi_image_id")
  spiPosition           Int       @map("spi_position")
  spiAlt                String    @db.VarChar(255) @map("spi_alt")
  spiWidth              Int       @map("spi_width")
  spiHeight             Int       @map("spi_height")
  spiSrc                String    @db.Text @map("spi_src")
  spiCreatedAt          DateTime  @default(now()) @db.DateTime @map("spi_created_at")
  spiUpdatedAt          DateTime  @default(now()) @db.DateTime @map("spi_updated_at")
  updatedOnShopify      DateTime? @db.DateTime @map("updated_on_shopify")

  // Indexes inferred from the 'MUL' keys in your image layout
  @@index([spId], map: "sp_id_idx")
  @@index([smStoreId], map: "sm_store_id_idx")
  @@index([npProductId], map: "np_product_id_idx")

  // Maps the Prisma model name to the underlying database table name
  @@map("shopify_products_images")
}


model shopifyCronRunHistory {
  scrh_id         Int        @id @default(autoincrement())
  scrh_store_id   Int?
  scrh_name       String     @db.VarChar(255)
  scrh_url        String     @db.VarChar(255)
  scrh_start_time DateTime
  scrh_end_time   DateTime?
  scrh_status     ScrhStatus
  scrh_created_at DateTime   @default(now()) @db.DateTime(0)
  scrh_updated_at DateTime   @default(now()) @updatedAt @db.DateTime(0)

  @@map("shopify_cron_run_history") 
}

enum ScrhStatus {
  failed
  InProgress
  completed
}

model ShopifyTrackingHistory {
  sth_id                  Int      @id @default(autoincrement())
  store_id                Int
  sp_product_id           String?  @db.VarChar(255)
  spv_variation_id        String?  @db.VarChar(255)
  sth_update_type         SthUpdateType
  sth_new_value           String?  @db.Text
  sth_status              SthStatus
  sth_message             String?  @db.Text
  sth_created_at          DateTime @default(now()) @db.DateTime(0)

  @@map("shopify_tracking_history")
}

enum SthUpdateType {
  product
  price
  inventory
  image
  inventoryPolicy
}

enum SthStatus {
  success
  failure
}