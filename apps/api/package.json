{
  "name": "@admin/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seeds/index.ts",
    "db:seed:mysql": "cross-env DATABASE_PROVIDER=mysql tsx prisma/seeds/seed-mysql.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:generate:mysql": "prisma generate --schema=./prisma/schema.mysql.prisma",
    "db:migrate:mysql": "prisma migrate dev --schema=./prisma/schema.mysql.prisma",
    "db:migrate:mysql:prod": "prisma migrate deploy --schema=./prisma/schema.mysql.prisma",
    "db:push:mysql": "prisma db push --schema=./prisma/schema.mysql.prisma",
    "db:studio:mysql": "prisma studio --schema=./prisma/schema.mysql.prisma",
    "db:reset:mysql": "prisma migrate reset --schema=./prisma/schema.mysql.prisma",
    "db:generate:all": "npm run db:generate && npm run db:generate:mysql",
    "sync:marketplace": "tsx src/scripts/sync-marketplace-inventory.ts",
    "sync:all-stores": "tsx src/scripts/sync-all-stores.ts",
    "reconcile-orders": "tsx src/cli/reconcile-orders.ts",
    "process-marketplace-orders": "tsx src/cli/process-marketplace-orders.ts"
  },
  "dependencies": {
    "@admin/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-s3": "^3.952.0",
    "@aws-sdk/s3-request-presigner": "^3.952.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.8.0",
    "@shopify/admin-api-client": "^1.1.1",
    "@shopify/shopify-api": "^12.2.0",
    "@types/archiver": "^7.0.0",
    "@types/pdfkit": "^0.17.4",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "axios": "^1.6.5",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.1.0",
    "bwip-js": "^4.11.2",
    "commander": "^14.0.2",
    "cron-parser": "^5.4.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "ebay-api": "^9.4.0",
    "exceljs": "^4.4.0",
    "fast-xml-builder": "^1.1.0",
    "fast-xml-parser": "^5.3.3",
    "fastify": "^4.25.2",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.3.2",
    "mime-types": "^3.0.2",
    "nanoid": "^5.0.4",
    "nodemailer": "^7.0.11",
    "otplib": "^12.0.1",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.17.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "sharp": "^0.33.1",
    "ssh2-sftp-client": "^12.1.1",
    "ua-parser-js": "^2.0.7",
    "undici": "^7.18.2",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/ua-parser-js": "^0.7.39",
    "cross-env": "^10.1.0",
    "fastify-plugin": "^4.5.1",
    "prisma": "^5.8.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
